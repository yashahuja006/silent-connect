{
  "name": "silent-connect-v3",
  "version": "3.0.0",
  "description": "Revolutionary Universal AI Platform featuring advanced voice-controlled hand gesture recognition, IoT control, health analytics, and custom AI training - built with Next.js 15 SaaS architecture",
  "private": true,
  "type": "module",
  "keywords": [
    "nextjs",
    "react",
    "typescript",
    "saas",
    "hand-gesture-recognition",
    "voice-control",
    "mediapipe",
    "ai-platform",
    "accessibility",
    "iot-control",
    "health-analytics",
    "supabase",
    "tailwindcss",
    "shadcn-ui"
  ],
  "author": {
    "name": "Yash Ahuja",
    "email": "yashahuja006@gmail.com",
    "url": "https://github.com/yashahuja006"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yashahuja006/silent-connect-v3.git"
  },
  "homepage": "https://silent-connect-v3.vercel.app",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "type-check": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "analyze": "ANALYZE=true npm run build",
    "db:generate": "supabase gen types typescript --project-id YOUR_PROJECT_ID > types/database.ts",
    "db:reset": "supabase db reset",
    "db:migrate": "supabase migration up",
    "postinstall": "npm run patch-deps",
    "patch-deps": "echo 'Dependencies patched'",
    "clean": "rm -rf .next out dist build",
    "prepare": "husky install"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.21",
    "@radix-ui/react-accordion": "^1.1.2",
